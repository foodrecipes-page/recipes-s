    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "crispy onions",
      "amount": "1/4 cup",
      "notes": "available pre-made"
    },
    {
      "name": "water",
      "amount": "1/2 cup"
    },
    {
      "name": "white flour",
      "amount": "1/4 cup"
    },
    {
      "name": "stir-fry oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "1. In a large bowl, mix together cornmeal, salt, and white flour.",
    "2. Gradually add in water, stirring with a spoon until a thick batter forms.",
    "3. Stir in crispy onions.",
    "4. Heat stir-fry oil in a large skillet over medium heat.",
    "5. Using a 1/4 cup measuring cup, scoop batter into the skillet.",
    "6. Flatten the batter slightly with a spatula.",
    "7. Cook for 4-5 minutes on each side, or until crispy and golden brown.",
    "8. Repeat with remaining batter.",
    "9. Serve warm and enjoy!"
  ],
